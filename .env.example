DEBUG=true

# Queue database (pgQueuer)
QUEUE_DB_URL=postgresql://user:password@localhost:5432/tarn_rag_queue

# Document / embedding storage (Postgres+pgvector in prod; sqlite:///./rag_docs.db for dev)
DOCUMENT_DB_URL=postgresql://user:password@localhost:5432/tarn_rag_docs

# Embedding (EMBEDDING_DIMENSION MUST match the model)
EMBEDDING_MODEL=sentence-transformers/all-minilm-l6-v2
EMBEDDING_DIMENSION=384
CHUNK_SIZE=512
CHUNK_OVERLAP=50
EMBEDDING_BATCH_SIZE=32

# Workers
WORKER_CONCURRENCY=4

# Uploads — staging dir for bytes posted to /v1/ingest/file (shared by API + workers)
UPLOAD_DIR=./uploads

# Observability
OBSERVABILITY_ENABLED=true
