
# Execution mode: embedded (in-process, default) or distributed (pgQueuer workers)
MODE=embedded

# Embedding output dim — MUST match the model (cross-cutting: index + repo use it)
EMBEDDING_DIMENSION=384

# Document id policy: uuid (engine-assigned, default) or caller (you supply every source_id).
# Strict — a mismatch fails ingestion. Ids are stable; content dedup uses the content_hash column.
ID_POLICY=uuid

# Embedding model (group EMBEDDING__*)
EMBEDDING__MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING__BATCH_SIZE=32

# Chunking (group CHUNKING__*)
CHUNKING__SIZE=512
CHUNKING__OVERLAP=50

# Databases (group DATABASE__*). MODE pins the backend: embedded → SQLite, distributed → Postgres.
DATABASE__DOCUMENT_URL=sqlite:///./rag_docs.db
# For MODE=distributed, use Postgres for both instead (queue_url is the pgQueuer DB):
# DATABASE__DOCUMENT_URL=postgresql://user:password@localhost:5432/tarn_rag_docs
# DATABASE__QUEUE_URL=postgresql://user:password@localhost:5432/tarn_rag_queue

# retrieval index (group INDEX__*)
INDEX__DB_PATH=./docs/index.db

# Uploads — staging dir for byte streams (shared by producer + workers in distributed mode)
UPLOAD_DIR=./docs/uploads

# Workers (group WORKER__*)
WORKER__CONCURRENCY=4

# Observability (group OBSERVABILITY__*)
OBSERVABILITY__ENABLED=true

# App metadata (group APP__*)
APP__DEBUG=true
